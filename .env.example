# ─── Contact form (Resend) ─────────────────────────────────────────
# Server-only secrets. Never prefix these with NEXT_PUBLIC_.

# API key from https://resend.com/api-keys  (permission: "Sending access" is enough)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact messages are delivered. Use the SAME Gmail address you
# signed up to Resend with (required while using onboarding@resend.dev).
CONTACT_TO_EMAIL=sibensongautam@gmail.com

# Sender shown in your inbox. Keep the default until you verify your own domain in Resend.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# ─── Public (safe to expose) ───────────────────────────────────────
# Your production URL, used for SEO / Open Graph links.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
